{
  "appId": "com.workflowz786.app",
  "appName": "workflow",
  "webDir": "public/build",
  "server": {
  "url": "https://6535554c7a03.ngrok-free.app",
  "cleartext": false,
  "androidScheme": "https"
},
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_workflow",
      "iconColor": "#4A90E2",
      "sound": "notification_sound",
      "actionTypes": [
        {
          "id": "CALL_ACTIONS",
          "actions": [
            {
              "id": "accept",
              "title": "Accept",
              "foreground": true
            },
            {
              "id": "decline",
              "title": "Decline",
              "destructive": true,
              "foreground": false
            }
          ]
        }
      ]
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "FCM": {
      "displayInForeground": true
    },
    "CallPlugin": {
      "ios": {
        "className": "CallPlugin",
        "enableCallKit": true
      },
      "android": {
        "className": "CallPlugin"
      }
    }
  }
}